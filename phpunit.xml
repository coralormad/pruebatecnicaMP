<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuración de PHPUnit.
    - bootstrap: carga el autoload de Composer (clases App\ y Tests\).
    - Suite "Unit": tests sin base de datos (validador, router).
    - failOn*: un aviso o una deprecación también cuenta como fallo, para no ignorarlos.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnDeprecation="true"
         failOnNotice="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
